{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".sim-test"
  },
  "include": ["app/lib/market-sim/**/*.ts"],
  "exclude": ["app/lib/market-sim/sim.worker.ts"]
}
