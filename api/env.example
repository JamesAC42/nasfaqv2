PORT=5067
DATABASE_URL=postgres://user:pass@localhost:5432/yourdb?sslmode=disable
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Comma-separated origins allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:3000,http://localhost:3010

# Auth/session
AUTH_SESSION_COOKIE_NAME=nasfaq_session
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=false

# Public app URL used in verification and password reset email links
PUBLIC_APP_BASE_URL=http://localhost:3010
EMAIL_VERIFICATION_PATH=/verify-email
EMAIL_VERIFICATION_TTL_HOURS=24

# Transactional email. If omitted, verification and password reset links are logged by the API.
# AUTH_EMAIL_FROM's domain must be verified in Resend (Domains), or every send fails.
RESEND_API_KEY=
AUTH_EMAIL_FROM=NASFAQ <auth@example.com>

# Cloudflare Turnstile. If TURNSTILE_SECRET_KEY is set, sign-in, sign-up and forgot-password require a token.
# In production (NODE_ENV=production) sign-up is refused while it is unset.
TURNSTILE_SECRET_KEY=
# Hostnames a token may be solved on, comma-separated. Defaults to PUBLIC_APP_BASE_URL's host in
# production and to any host elsewhere.
TURNSTILE_HOSTNAMES=

# Linking alts (services/ipHash.js): sign-up and each session store a salted hash of the IP address,
# never the address, and admins see which accounts share one. A long random secret, e.g.
# `openssl rand -hex 32`; never commit a real one. Unset, nothing is stored and linking is off.
# Changing it later starts the links over (old hashes stop matching new ones).
IP_HASH_SALT=

# Abuse limits (src/rateLimit.js, src/socketLimits.js), counted in Redis across pods. The defaults are
# the intended ones; these are for an emergency without a release.
# Writes (POST/PUT/PATCH/DELETE) per signed-in player per minute, on top of each route's own rules.
WRITES_PER_MINUTE=60
# Open WebSockets per IP address (CF-Connecting-IP), and messages per socket per 10 seconds.
WS_MAX_CONNECTIONS_PER_IP=60
WS_MAX_MESSAGES_PER_10S=30
# Password hashes (scrypt, 128 MiB each) running at once per process; the rest queue.
PASSWORD_HASH_CONCURRENCY=2

# Production alerts (services/alerts.js, services/watchdog.js): no settlement by 09:30 ET, a failed
# settlement cycle, an incomplete YouTube scrape, a scheduler that stops or stalls, a burst of
# unhandled errors. Posted to this Discord webhook (channel settings > Integrations > Webhooks); unset,
# nothing is sent. It's a secret: never commit a real one.
DISCORD_ALERT_WEBHOOK_URL=
# Optional: a role ID to @mention on every new alert (resolved posts never ping).
DISCORD_ALERT_ROLE_ID=
# Unhandled API errors in 5 minutes, across every pod, before an alert.
WATCHDOG_ERROR_THRESHOLD=20
# false stops the watchdog everywhere.
WATCHDOG_ENABLED=true

# AWS S3 icon uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_SW_BUCKET=
# Optional: a key for scripts/upload-art.js that can only write art/ (DEPLOYMENT.md 2.6.1).
# Falls back to the AWS_* key above. Never commit real values.
ART_UPLOAD_AWS_ACCESS_KEY_ID=
ART_UPLOAD_AWS_SECRET_ACCESS_KEY=

# HoloNews thumbnail regeneration
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_TIMEOUT_SECONDS=90
REFERENCE_IMAGES_BASE_URL=https://images.nasfaq.biz/reference-images
THUMBNAIL_S3_PREFIX=thumbnails
THUMBNAIL_CDN_BASE_URL=https://images.nasfaq.biz

# Optional: apply the ytscraper schema on API startup (requires permissions)
ENABLE_MIGRATIONS=false

# The admin page's "Reset market" (wipes every player's holdings and history) only works when this
# is true. Leave it unset in production.
ALLOW_MARKET_RESET=false

# Market behavior tuning
MARKET_TRANSIENT_HALF_LIFE_MINUTES=60
MARKET_TRANSIENT_IMPACT_WEIGHT=0.70
MARKET_PERSISTENT_IMPACT_WEIGHT=0.15
MARKET_EXECUTION_SLIPPAGE_WEIGHT=0.50
MARKET_PERSISTENT_DAILY_DECAY=0.90
MARKET_TRANSIENT_SETTLEMENT_DECAY=0.10
MARKET_ADJUSTMENT_SCHEDULER_ENABLED=true
MARKET_ADJUSTMENT_SCHEDULER_INTERVAL_MS=60000
MARKET_LIVE_ORDER_SHARE_LIMIT_PER_INTERVAL=180
MARKET_LIVE_ORDER_SCHEDULER_INTERVAL_MS=1000
MARKET_LIVE_ORDER_WORKER_CONCURRENCY=4
MARKET_ADJUSTMENT_TIMEZONE=America/New_York



# Chat history: keep the newest messages per room regardless of age.
CHAT_HISTORY_VISIBLE_DAYS=30
CHAT_HISTORY_MIN_MESSAGES=100
